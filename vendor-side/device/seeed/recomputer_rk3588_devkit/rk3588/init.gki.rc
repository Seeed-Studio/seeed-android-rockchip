
on init
    write /sys/devices/platform/usbdrd3_0/fc000000.usb/power/control auto
    write /sys/devices/platform/usbdrd3_0/fc000000.usb/power/autosuspend_delay_ms 1000
    write /sys/devices/platform/usbdrd3_1/fc400000.usb/power/control auto
    write /sys/devices/platform/usbdrd3_1/fc400000.usb/power/autosuspend_delay_ms 1000

