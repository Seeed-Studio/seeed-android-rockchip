+/*
+ * es8311 codec route table.
+ *
+ * The es8311 driver (kernel-6.1 sound/soc/codecs/es8311.c) uses DAPM for the
+ * codec path (I2S IN -> DAC SDP SRC MUX -> MONO DAC -> DIFFERENTIAL OUT), and
+ * the machine driver (rockchip_multicodecs.c) connects DIFFERENTIAL OUT to the
+ * "Headphone"/"Speaker" pins whose DAPM events toggle the PA GPIO. So the
+ * analog path is powered automatically once the PCM stream opens; this table
+ * only needs to keep the digital volumes at 0 dB (range 0~255, 0 dB == 191).
+ */
+
+const struct config_control es8311_speaker_normal_controls[] = {
+    {
+        .ctl_name = "DAC VOLUME",
+        .int_val = {191, 191},
+    },
+};
