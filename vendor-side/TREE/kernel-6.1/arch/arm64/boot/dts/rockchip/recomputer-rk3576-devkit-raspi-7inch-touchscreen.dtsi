#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/display/drm_mipi_dsi.h>

/ {
	touch_reg: touch_reg {
		compatible = "regulator-fixed";
		regulator-name = "touch_reg_1";
		gpio = <&display_mcu 1 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <50000>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0m1_xfer>;

	display_mcu: display_mcu@45 {
		compatible = "raspberrypi,v2-touchscreen-panel-regulator";
		reg = <0x45>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	gt911: gt911@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		AVDD28-supply = <&touch_reg>;
		touchscreen-size-x = <720>;
		touchscreen-size-y = <1280>;
		touchscreen-x-mm = <90>;
		touchscreen-y-mm = <151>;
		// touchscreen-inverted-x;
		// touchscreen-inverted-y;
		// touchscreen-swapped-x-y;
	};
};

&dsi {
	status = "okay";

	dsi_panel: dsi_panel@0 {
		reg = <0>;
		compatible = "simple-panel-dsi";
		reset-gpios = <&display_mcu 0 GPIO_ACTIVE_LOW>;
		backlight = <&display_mcu>;
		rotation = <90>;
		width-mm = <90>;
		height-mm = <151>;

		dsi,lanes = <2>;
		dsi,format = <MIPI_DSI_FMT_RGB888>;
		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_LPM)>;

		prepare-delay-ms = <5>;
		reset-delay-ms = <20>;
		init-delay-ms = <20>;

