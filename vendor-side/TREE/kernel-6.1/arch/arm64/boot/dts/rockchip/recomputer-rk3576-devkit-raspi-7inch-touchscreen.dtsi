		display-timings {
			native-mode = <&rpi_7inch_timing>;

			rpi_7inch_timing: timing0 {
				clock-frequency = <83330000>;
				hactive = <720>;
				hfront-porch = <239>;
				hsync-len = <33>;
				hback-porch = <50>;
				vactive = <1280>;
				vfront-porch = <20>;
				vsync-len = <2>;
				vback-porch = <30>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};

		port {
			panel_in_dsi: endpoint {
				remote-endpoint = <&dsi_out_panel>;
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			dsi_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi>;
			};
		};
	};
};

&vp2 {
	status = "okay";
};

&dsi_in_vopl {
	status = "disabled";
};

&dsi_in_vp2 {
	status = "okay";
};

&dsi_in_vp1 {
	status = "disabled";
};

&dsi_in_vp0 {
	status = "disabled";
};

&route_dsi {
	status = "disabled";
	connect = <&vp2_out_dsi>;
};
