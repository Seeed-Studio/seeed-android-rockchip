# reComputer rk3588 devkit kernel config fragment (GKI build:
# gki_defconfig + rockchip_gki.config + valhall_gpu_gki.config + this file).
# Selected via `PRODUCT_KERNEL_CONFIG +=` in
# vendor-side/device/seeed/recomputer_rk3588_devkit/BoardConfig.mk.
# Hardware per rk3588-recomputer-rk3588-devkit.dts.

# Dual 2.5GbE: PCIe RTL8125 NICs (rtl_eth0/rtl_eth1 on pcie2x1l2/pcie2x1l0).
# No r8125 vendor driver in this kernel — mainline r8169 drives RTL8125.
CONFIG_R8169=y

# &sfc + SPI NOR flash
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_BLOCK=y
CONFIG_SPI_ROCKCHIP_SFC=y

# fan0 (pwm-fan on pwm2, tach on gpio3 B6)
CONFIG_HWMON=y
CONFIG_SENSORS_PWM_FAN=y

# pcf8563 RTC on i2c6 (also the wifi ext clock source)
CONFIG_RTC_DRV_PCF8563=y

# at24c256 EEPROM on i2c4 (40-pin header ID)
CONFIG_EEPROM_AT24=y

# imx708 camera (nodes disabled by default in the cam dtsi; sensor driver
# file + Kconfig/Makefile hookup come from TREE + PATCHES/kernel-6.1/0001)
CONFIG_VIDEO_IMX708=y
CONFIG_VIDEO_DW9800W=y

CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_REGULATOR_RASPBERRYPI_TOUCHSCREEN_V2=y