# Board device tree: the EVB default (rk3588-evb) drives eMMC at HS400
# enhanced strobe and SD card-detect via GPIO0_A4 — neither matches this
# board (HS200 wiring; dedicated sdmmc_det pad), leaving SPL unable to
# read any mmc medium. See arch/arm/dts/rk3588-recomputer-rk3588-devkit.dts.
CONFIG_DEFAULT_DEVICE_TREE="rk3588-recomputer-rk3588-devkit"
CONFIG_OF_LIST="rk3588-recomputer-rk3588-devkit"
CONFIG_ANDROID_AB=y
